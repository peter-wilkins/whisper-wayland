# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Whisper Configuration
WHISPER_MODEL=base

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024
MAX_RECORDING_DURATION=30

# Logging Configuration
LOG_LEVEL=INFO

# Hotkey Configuration
HOTKEY=compose

# Service Configuration (for future steps)
SERVICE_NAME=whisper-claude
SERVICE_DESCRIPTION=Voice-to-text transcription service

# Docker Configuration (for future steps)
DOCKER_AUDIO_DEVICE=/dev/snd
DOCKER_DISPLAY_VAR=DISPLAY

# Text Insertion Configuration (for future steps)
TEXT_INSERTION_DELAY=0.1
TEXT_INSERTION_METHOD=wtype
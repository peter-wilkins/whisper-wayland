AUDIO_CHUNK_SIZE=1024
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_INPUT_DEVICE_NAME=
AUDIO_LEVEL_AUTO_ADJUST_ENABLED=false
AUDIO_LEVEL_CHECK_INTERVAL_SECS=900
AUDIO_LEVEL_MANAGE_MICS_ENABLED=false
AUDIO_LEVEL_MONITOR_ENABLED=false
AUDIO_LEVEL_SOURCE=@DEFAULT_SOURCE@
AUDIO_TRANSCRIPTION_NORMALIZATION_ENABLED=false
AUDIO_TRANSCRIPTION_NORMALIZATION_TARGET_RMS_DBFS=-22
AUDIO_TRANSCRIPTION_NORMALIZATION_MAX_PEAK_AMPLITUDE=0.95
AUDIO_TRANSCRIPTION_NORMALIZATION_MAX_GAIN=6
TRANSCRIPTION_VAD_AUTO_MIN_DURATION_SECONDS=30
AUDIO_TRANSCRIPTION_VAD_MODE=auto
LOCAL_API_DEFAULT_VAD_MODE=auto
PRETRANSCRIPTION_CHUNK_WHISPER_MODEL=whisper-1
PRETRANSCRIPTION_CHUNK_RACE_MODELS=
PRETRANSCRIPTION_CHUNKING_ENABLED=false
PRETRANSCRIPTION_CHUNK_MIN_RECORDING_SECONDS=10
PRETRANSCRIPTION_CHUNK_POLL_INTERVAL_SECONDS=2
PRETRANSCRIPTION_CHUNK_STABLE_TAIL_SECONDS=3
PRETRANSCRIPTION_CHUNK_COALESCE_MIN_DURATION_SECONDS=4
PRETRANSCRIPTION_CHUNK_COALESCE_MAX_DURATION_SECONDS=12
PRETRANSCRIPTION_CHUNK_COALESCE_MAX_GAP_SECONDS=3
AUDIO_PREROLL_SECONDS=1.0
AUDIO_SAMPLE_RATE=16000
HOTKEY=ctrl+compose
HOTKEY_MODE=push_to_talk
LOG_LEVEL=INFO
MAX_RECORDING_DURATION=30
OPENAI_API_KEY=your_openai_api_key_here
TEXT_POST_PROCESS_OPENAI_API_KEY=
TEXT_INSERTION_DELAY=0.1
TEXT_INSERTION_METHOD=auto
TEXT_INSERTION_MARKER_ENABLED=false
TEXT_TMUX_TARGET_PANE=
TEXT_PASTE_HOTKEY=ctrl+v
# raw, clean, snappy, caveman, or extract
TEXT_POST_PROCESS_MODE=raw
TEXT_POST_PROCESS_MODEL=gpt-4.1-mini
TEXT_POST_PROCESS_PROVIDERS=openai,local
TEXT_POST_PROCESS_LOCAL_API_URL=http://127.0.0.1:8765/v1/transcript/rewrite
TEXT_POST_PROCESS_LOCAL_API_TIMEOUT_SECS=1.5
CONTINUUM_CAPTURE_INLET_DIR=
WHISPER_MODEL=gpt-4o-transcribe
STREAMING_TRANSCRIPTION_ENABLED=false
STREAMING_TRANSCRIPTION_MODEL=gpt-realtime-whisper
STREAMING_SAMPLE_RATE=24000
STREAMING_COMPLETION_TIMEOUT_SECS=4
STREAMING_DELTA_IDLE_TIMEOUT_SECS=0.75
STREAMING_TURN_DETECTION_ENABLED=false
STREAMING_VAD_SILENCE_DURATION_MS=700
